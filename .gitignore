# common.gitignore の内容も必ず併せて使うこと

# ========== PowerShell ==========
# Pester テスト出力
TestResults.xml
coverage.xml

# モジュールビルド成果物
Output/
publish/

# ただし output/ の資料成果物(お客様配布用 PowerPoint 等)は追跡する
!output/
!output/*.pptx

# PSScriptAnalyzer キャッシュ
.psscriptanalyzer/

# ========== Local Tools Launcher ==========
# ランチャー実行ログ
reports/local-tools/

# ローカルエージェント設定
.claude/

# subagent-driven-development の進捗台帳(スクラッチ)
.superpowers/

# ========== Python (tools/perf-monitor 等) ==========
__pycache__/
*.pyc

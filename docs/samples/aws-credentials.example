# ============================================================
# AWS CLI credentials サンプル
# 配置先: %USERPROFILE%\.aws\credentials   (Windows)
#         ~/.aws/credentials              (macOS/Linux)
# 環境変数 AWS_SHARED_CREDENTIALS_FILE で別パス指定も可能。
#
# 重要: 実際の鍵をコミットしないこと (.gitignore で除外推奨)
# ============================================================


# ------------------------------------------------------------
# IAM Access Key 型のプロファイル
# config 側のプロファイル名 (例: bedrock-key) と一致させる。
# ------------------------------------------------------------
[bedrock-key]
aws_access_key_id = AKIAIOSFODNN7EXAMPLE
aws_secret_access_key = wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY


# ------------------------------------------------------------
# デフォルト用 (任意)
# ------------------------------------------------------------
[default]
aws_access_key_id = AKIAIOSFODNN7EXAMPLE
aws_secret_access_key = wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY


# ------------------------------------------------------------
# 注意事項
# ------------------------------------------------------------
# - SSO ベースのプロファイル (aws-config.example の 1 / 2) は
#   credentials ファイルに何も書く必要はない。
#   トークンは `~/.aws/sso/cache/*.json` に自動キャッシュされる。
#
# - 一時的な認証情報 (STS / AssumeRole の結果) を直接書く場合は
#   aws_session_token も併記する:
#       [tmp]
#       aws_access_key_id = ASIA...
#       aws_secret_access_key = ...
#       aws_session_token = ...
#
# - 平文保存になるため、可能なら SSO を使う。
#   どうしてもアクセスキー運用するなら IAM で最小権限 + 定期ローテーション必須。

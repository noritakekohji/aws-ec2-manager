<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ツールランチャー"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#101418">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#171D23" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#32404D" />
        <SolidColorBrush x:Key="MainTextBrush" Color="#E8EEF3" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#A7B4C0" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MainTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0F1419" />
            <Setter Property="Foreground" Value="{StaticResource MainTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#25313B" />
            <Setter Property="Foreground" Value="{StaticResource MainTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinWidth" Value="92" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource MainTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#176CCB" />
            <Setter Property="BorderBrush" Value="#2E8CFF" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="ツールランチャー" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="ConfigPathText" Foreground="{StaticResource MutedTextBrush}" Margin="14,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="SaveSettingsButton" Content="設定保存" Margin="0,0,8,0" />
                    <Button x:Name="OpenConfigButton" Content="設定場所" Margin="0,0,8,0" />
                    <Button x:Name="OpenOutputButton" Content="保存先を開く" />
                </StackPanel>

                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="210" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ツールルート" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="ToolsRootTextBox" Grid.Column="1" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="2" Text="AWS Profile" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="AwsProfileTextBox" Grid.Column="3" />
                </Grid>

                <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="出力保存先" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="OutputRootTextBox" Grid.Column="1" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="285" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="6" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="ツール" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" />
                    <ListBox x:Name="ToolListBox" Grid.Row="1" Background="#0F1419" Foreground="{StaticResource MainTextBrush}" BorderBrush="{StaticResource BorderBrushSoft}" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="6" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="105" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#121820" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="スナップショット統合ツール" FontWeight="SemiBold" FontSize="15" />

                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="112" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="収集ラベル" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="SnapshotLabelTextBox" Grid.Column="1" Margin="0,0,10,0" />
                                <Button x:Name="RunCollectSnapshotButton" Grid.Column="2" Content="収集実行" Style="{StaticResource PrimaryButton}" />
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="112" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ZIP パス" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="SnapshotZipTextBox" Grid.Column="1" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="2" Text="比較 ZIP" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="SnapshotCompareZipTextBox" Grid.Column="3" Margin="0,0,10,0" />
                                <CheckBox x:Name="SnapshotDiffOnlyCheckBox" Grid.Column="4" Content="差分のみ" />
                                <Button x:Name="RunSnapshotReportButton" Grid.Column="5" Content="レポート生成" />
                            </Grid>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="ToolTitleText" Grid.Row="1" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="ToolDescriptionText" Grid.Row="2" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,12" TextWrapping="Wrap" />

                    <Grid Grid.Row="3" Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="145" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="実行パラメーター" FontWeight="SemiBold" Margin="0,0,0,8" Grid.ColumnSpan="2" />

                        <TextBlock x:Name="Param1Label" Grid.Row="1" Text="Param1" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="Param1TextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />

                        <TextBlock x:Name="Param2Label" Grid.Row="2" Text="Param2" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="Param2TextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" />

                        <TextBlock x:Name="Param3Label" Grid.Row="3" Text="Param3" Style="{StaticResource FieldLabel}" />
                        <Grid Grid.Row="3" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="Param3TextBox" Margin="0,0,12,0" />
                            <CheckBox x:Name="Option1CheckBox" Grid.Column="1" Content="HTML レポート" />
                            <CheckBox x:Name="Option2CheckBox" Grid.Column="2" Content="失敗のみ" />
                        </Grid>
                    </Grid>

                    <TextBlock Grid.Row="4" Text="コマンドプレビュー" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <TextBox x:Name="CommandPreviewTextBox" Grid.Row="4" Margin="0,24,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

                    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,10">
                        <Button x:Name="RefreshPreviewButton" Content="プレビュー更新" Margin="0,0,8,0" />
                        <Button x:Name="RunButton" Content="実行" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                        <Button x:Name="StopButton" Content="停止" Margin="0,0,8,0" IsEnabled="False" />
                        <Button x:Name="OpenLastRunButton" Content="直近出力" />
                    </StackPanel>

                    <TextBox x:Name="LogTextBox" Grid.Row="6" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" />
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="{StaticResource MutedTextBrush}" Margin="2,10,0,0" />
    </Grid>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ツールランチャー"
        Width="1180"
        Height="860"
        MinWidth="980"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <!-- aws-ec2-manager (MainWindow.xaml) と同一パレット。変更時は両方を合わせる -->
        <SolidColorBrush x:Key="AppBg" Color="#0F172A" />
        <SolidColorBrush x:Key="PanelBg" Color="#172033" />
        <SolidColorBrush x:Key="PanelAltBg" Color="#111827" />
        <SolidColorBrush x:Key="FieldBg" Color="#0B1220" />
        <SolidColorBrush x:Key="LineBrush" Color="#263247" />
        <SolidColorBrush x:Key="MutedText" Color="#94A3B8" />
        <SolidColorBrush x:Key="MainText" Color="#E5E7EB" />
        <SolidColorBrush x:Key="Accent" Color="#38BDF8" />
        <SolidColorBrush x:Key="AccentStrong" Color="#0EA5E9" />
        <SolidColorBrush x:Key="Success" Color="#22C55E" />
        <SolidColorBrush x:Key="Warn" Color="#F59E0B" />
        <SolidColorBrush x:Key="Danger" Color="#EF4444" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MainText}" />
        </Style>

        <Style x:Key="MutedLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedLabel}">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EAF6FF" />
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#26364F" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#0B1220" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#64748B" />
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#111827" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#1F2937" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentStrong}" />
            <Setter Property="BorderBrush" Value="#7DD3FC" />
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#15803D" />
            <Setter Property="BorderBrush" Value="#4ADE80" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#B91C1C" />
            <Setter Property="BorderBrush" Value="#F87171" />
        </Style>

        <Style x:Key="SmallBrowseButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Padding" Value="6,4" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource MainText}" />
            <Setter Property="Background" Value="{StaticResource FieldBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboChrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="28" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Content="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      ContentTemplate="{TemplateBinding ItemTemplate}"
                                                      RecognizesAccessKey="True" />
                                    <Path Grid.Column="1"
                                          Width="8"
                                          Height="5"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Fill="{StaticResource MutedText}"
                                          Data="M 0 0 L 8 0 L 4 5 Z" />
                                </Grid>
                            </Border>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          Opacity="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" />

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Slide">
                                <Grid MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="{StaticResource FieldBg}"
                                            BorderBrush="{StaticResource Accent}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="0,3,0,0" />
                                    <ScrollViewer Margin="1,4,1,1"
                                                  Background="{StaticResource FieldBg}">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="ToggleButton" Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="PART_Popup" Property="MinHeight" Value="30" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboChrome" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource MainText}" />
            <Setter Property="Background" Value="{StaticResource FieldBg}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemChrome"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              ContentSource="Content"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#1E293B" />
                                <Setter Property="Foreground" Value="#F8FAFC" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#075985" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#64748B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource MainText}" />
            <Setter Property="Background" Value="{StaticResource FieldBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Foreground" Value="{StaticResource MainText}" />
            <Setter Property="Background" Value="{StaticResource FieldBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Foreground" Value="{StaticResource MainText}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0EA5E9" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E293B" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource MainText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="260" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="180" MinHeight="90" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ ヘッダー(aws-ec2-manager と同構造) ============ -->
        <Border Grid.Row="0" Padding="18,14" BorderBrush="#263247" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#0B1220" Offset="0" />
                    <GradientStop Color="#142238" Offset="0.58" />
                    <GradientStop Color="#062235" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0">
                    <Border Width="36" Height="36" CornerRadius="8" Background="#0EA5E9" Margin="0,0,10,0">
                        <TextBlock Text="OPS" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="White" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="ツールランチャー" FontSize="19" FontWeight="SemiBold" Foreground="#F8FAFC" />
                        <TextBlock Text="Local Ops Tools" Style="{StaticResource MutedLabel}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="AWS Profile" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="HeaderAwsProfileComboBox" Width="220" VerticalAlignment="Center"
                              ToolTip="~/.aws/config のプロファイル一覧。AWS を使うツールの {AwsProfile} に渡される" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="OpenOutputButton" Margin="0,0,8,0" ToolTip="ツールの保存場所 (tools) をエクスプローラで開く">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="ツール保存先" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="OpenLogButton" Margin="0,0,8,0" ToolTip="出力先 (reports) をエクスプローラで開く">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="出力先" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="OpenSettingsButton" ToolTip="設定">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="設定" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ スナップショット一括実行 ============ -->
        <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Margin="16,12,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="スナップショット一括実行" FontWeight="SemiBold" FontSize="15" Foreground="#BAE6FD" />

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="収集ラベル" Style="{StaticResource FieldLabel}" ToolTip="収集 ZIP のファイル名に含める識別ラベル(任意)" />
                    <TextBox x:Name="SnapshotLabelTextBox" Grid.Column="1" Margin="0,0,12,0" ToolTip="収集 ZIP のファイル名に含める識別ラベル(任意)" />
                    <Button x:Name="RunCollectSnapshotButton" Grid.Column="2" Content="収集実行" Style="{StaticResource PrimaryButton}" />
                </Grid>

                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="出力対象" Style="{StaticResource FieldLabel}" ToolTip="レポート生成の入力となる ZIP または server-snapshot JSON のフルパス。収集実行が成功すると ZIP が自動で入る" />
                    <TextBox x:Name="SnapshotZipTextBox" Grid.Column="1" Margin="0,0,4,0" ToolTip="レポート生成の入力となる ZIP または server-snapshot JSON のフルパス。収集実行が成功すると ZIP が自動で入る" />
                    <Button x:Name="BrowseSnapshotZipButton" Grid.Column="2" Content="..." Style="{StaticResource SmallBrowseButton}" Margin="0,0,12,0" ToolTip="出力対象 ZIP / JSON をエクスプローラから選択" />
                    <TextBlock Grid.Column="3" Text="比較対象" Style="{StaticResource FieldLabel}" ToolTip="(任意) 差分比較に使う、もう一方の ZIP または server-snapshot JSON" />
                    <TextBox x:Name="SnapshotCompareZipTextBox" Grid.Column="4" Margin="0,0,4,0" ToolTip="(任意) 差分比較に使う、もう一方の ZIP または server-snapshot JSON" />
                    <Button x:Name="BrowseSnapshotCompareZipButton" Grid.Column="5" Content="..." Style="{StaticResource SmallBrowseButton}" Margin="0,0,12,0" ToolTip="比較対象 ZIP / JSON をエクスプローラから選択" />
                    <CheckBox x:Name="SnapshotDiffOnlyCheckBox" Grid.Column="6" Content="差分のみ" ToolTip="比較対象との差分のみをレポートに含める" />
                    <Button x:Name="RunSnapshotReportButton" Grid.Column="7" Content="レポート生成" ToolTip="「出力対象」を入力に HTML レポートを生成する" />
                </Grid>
            </Grid>
        </Border>

        <!-- ============ ツール一覧 + 詳細 ============ -->
        <Grid Grid.Row="2" Margin="16,12,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="ツール個別実行" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" Foreground="#BAE6FD" />
                    <ListBox x:Name="ToolListBox" Grid.Row="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ToolTitleText" Grid.Column="0" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#F8FAFC" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="RunButton" Style="{StaticResource SuccessButton}" Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" Margin="0,0,7,0" /><TextBlock Text="実行" /></StackPanel>
                                </Button>
                                <Button x:Name="StopButton" Style="{StaticResource DangerButton}" Margin="8,0,0,0" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71A;" Margin="0,0,7,0" /><TextBlock Text="停止" /></StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="ToolDescriptionText" Grid.Row="1" Foreground="{StaticResource MutedText}" Margin="0,2,0,10" FontSize="12" TextWrapping="Wrap" />

                        <StackPanel x:Name="ConfigFilesPanel" Grid.Row="2" Margin="0,0,0,12" Visibility="Collapsed">
                            <TextBlock Text="設定ファイル" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#BAE6FD" />
                            <StackPanel x:Name="ConfigFilesItems" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Margin="0,0,0,10">
                            <TextBlock Text="実行パラメーター" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#BAE6FD" />
                            <StackPanel x:Name="ParametersItems" />
                        </StackPanel>

                        <TextBlock Grid.Row="4" Text="コマンドプレビュー(パラメーター変更で自動更新)" Style="{StaticResource MutedLabel}" Margin="0,0,0,5" />
                        <TextBox x:Name="CommandPreviewTextBox" Grid.Row="5" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="56" MaxHeight="110" FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource MutedText}" />
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="3"
                      Height="8"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      Background="Transparent"
                      ShowsPreview="False" />

        <!-- ============ ログ(高さは上のスプリッタで調整可能) ============ -->
        <Border Grid.Row="4" Style="{StaticResource PanelBorder}" Margin="16,0,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="OpenLastRunButton" Margin="0,0,8,0" Padding="10,3" MinHeight="24" ToolTip="直近の実行結果フォルダ(ログ・成果物)をエクスプローラで開く">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE838;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" /><TextBlock Text="実行結果フォルダ" FontSize="12" /></StackPanel>
                        </Button>
                        <Button x:Name="ClearLogButton" Padding="10,3" MinHeight="24" ToolTip="ログ表示をクリア(ファイルは消えません)">
                            <TextBlock Text="クリア" FontSize="12" />
                        </Button>
                    </StackPanel>
                    <TextBlock Text="ログ出力" FontWeight="SemiBold" Foreground="#BAE6FD" />
                </DockPanel>
                <TextBox x:Name="LogTextBox" Grid.Row="1" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" />
            </Grid>
        </Border>

        <!-- ============ ステータスバー ============ -->
        <Border Grid.Row="5" Background="#0B1220" BorderBrush="#263247" BorderThickness="0,1,0,0" Padding="14,7" Margin="0,10,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="8" Height="8" CornerRadius="4" Background="{StaticResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <ProgressBar x:Name="RunProgressBar"
                             DockPanel.Dock="Right"
                             Width="150" Height="12"
                             IsIndeterminate="True"
                             Visibility="Collapsed"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource AccentStrong}"
                             Background="#172033" />
                <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>

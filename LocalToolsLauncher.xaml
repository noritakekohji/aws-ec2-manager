<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ツールランチャー"
        Width="1180"
        Height="860"
        MinWidth="980"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#101418">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#171D23" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#32404D" />
        <SolidColorBrush x:Key="MainTextBrush" Color="#E8EEF3" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#A7B4C0" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MainTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0F1419" />
            <Setter Property="Foreground" Value="{StaticResource MainTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#25313B" />
            <Setter Property="Foreground" Value="{StaticResource MainTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinWidth" Value="92" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource MainTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#176CCB" />
            <Setter Property="BorderBrush" Value="#2E8CFF" />
        </Style>
        <Style x:Key="SmallBrowseButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="300" />
            <RowDefinition Height="170" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header (slim) -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="ツールランチャー" FontSize="22" FontWeight="SemiBold" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,12,0">
                    <TextBlock Text="AWS Profile" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="HeaderAwsProfileTextBox" Width="200" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button x:Name="OpenOutputButton" Margin="0,0,8,0" ToolTip="ツールの保存場所 (tools) をエクスプローラで開く">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="ツール保存先" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="OpenLogButton" Margin="0,0,8,0" ToolTip="出力先 (reports) をエクスプローラで開く">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="出力先" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="OpenSettingsButton" ToolTip="設定">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="設定" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Snapshot integration tool (top-level) -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="スナップショット一括実行" FontWeight="SemiBold" FontSize="15" />

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="収集ラベル" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="SnapshotLabelTextBox" Grid.Column="1" Margin="0,0,12,0" />
                    <Button x:Name="RunCollectSnapshotButton" Grid.Column="2" Content="収集実行" Style="{StaticResource PrimaryButton}" />
                </Grid>

                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="出力対象" Style="{StaticResource FieldLabel}" ToolTip="レポート生成の入力となる ZIP または server-snapshot JSON のフルパス。収集実行が成功すると ZIP が自動で入る" />
                    <TextBox x:Name="SnapshotZipTextBox" Grid.Column="1" Margin="0,0,4,0" ToolTip="レポート生成の入力となる ZIP または server-snapshot JSON のフルパス。収集実行が成功すると ZIP が自動で入る" />
                    <Button x:Name="BrowseSnapshotZipButton" Grid.Column="2" Content="..." Style="{StaticResource SmallBrowseButton}" Margin="0,0,12,0" ToolTip="出力対象 ZIP / JSON をエクスプローラから選択" />
                    <TextBlock Grid.Column="3" Text="比較対象" Style="{StaticResource FieldLabel}" ToolTip="(任意) 差分比較に使う、もう一方の ZIP または server-snapshot JSON" />
                    <TextBox x:Name="SnapshotCompareZipTextBox" Grid.Column="4" Margin="0,0,4,0" ToolTip="(任意) 差分比較に使う、もう一方の ZIP または server-snapshot JSON" />
                    <Button x:Name="BrowseSnapshotCompareZipButton" Grid.Column="5" Content="..." Style="{StaticResource SmallBrowseButton}" Margin="0,0,12,0" ToolTip="比較対象 ZIP / JSON をエクスプローラから選択" />
                    <CheckBox x:Name="SnapshotDiffOnlyCheckBox" Grid.Column="6" Content="差分のみ" ToolTip="比較対象との差分のみをレポートに含める" />
                    <Button x:Name="RunSnapshotReportButton" Grid.Column="7" Content="レポート生成" ToolTip="「出力対象」を入力に HTML レポートを生成する" />
                </Grid>
            </Grid>
        </Border>

        <!-- Split pane: tools (left) + parameters/preview/log (right) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="285" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="6" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="ツール個別実行" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" />
                    <ListBox x:Name="ToolListBox" Grid.Row="1" Background="#0F1419" Foreground="{StaticResource MainTextBrush}" BorderBrush="{StaticResource BorderBrushSoft}" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="6" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Title row: name on the left, action buttons on the right -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ToolTitleText" Grid.Column="0" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="RefreshPreviewButton" Content="プレビュー更新" Margin="8,0,0,0" />
                            <Button x:Name="RunButton" Content="実行" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
                            <Button x:Name="StopButton" Content="停止" Margin="8,0,0,0" IsEnabled="False" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="ToolDescriptionText" Grid.Row="1" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,8" FontSize="12" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="2" Text="コマンドプレビュー" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <TextBox x:Name="CommandPreviewTextBox" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="56" MaxHeight="90" Margin="0,0,0,10" />

                    <StackPanel x:Name="ConfigFilesPanel" Grid.Row="4" Margin="0,0,0,12" Visibility="Collapsed">
                        <TextBlock Text="設定ファイル" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <StackPanel x:Name="ConfigFilesItems" />
                    </StackPanel>

                    <StackPanel Grid.Row="5" Margin="0,0,0,10">
                        <TextBlock Text="実行パラメーター" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <StackPanel x:Name="ParametersItems" />
                    </StackPanel>

                    <!-- Row 6 (*) is an empty spacer keeping content top-aligned. -->
                </Grid>
            </Border>
        </Grid>

        <!-- Shared log pane (common to all tools) -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="ログ出力" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBox x:Name="LogTextBox" Grid.Row="1" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Background="#0F1419" />
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="4" Foreground="{StaticResource MutedTextBrush}" Margin="2,8,0,0" />
    </Grid>
</Window>

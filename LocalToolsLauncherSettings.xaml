<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定"
        Width="640"
        Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#101418">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#171D23" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#32404D" />
        <SolidColorBrush x:Key="MainTextBrush" Color="#E8EEF3" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#A7B4C0" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MainTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0F1419" />
            <Setter Property="Foreground" Value="{StaticResource MainTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#25313B" />
            <Setter Property="Foreground" Value="{StaticResource MainTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinWidth" Value="92" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource MainTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#176CCB" />
            <Setter Property="BorderBrush" Value="#2E8CFF" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="ランチャー設定" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="92" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="ツールルート" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="ToolsRootTextBox" Grid.Column="1" Margin="0,0,8,0" />
                <Button x:Name="BrowseToolsRootButton" Grid.Column="2" Content="参照..." />
            </Grid>

            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="92" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="出力保存先" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="OutputRootTextBox" Grid.Column="1" Margin="0,0,8,0" />
                <Button x:Name="BrowseOutputRootButton" Grid.Column="2" Content="参照..." />
            </Grid>

            <Grid Grid.Row="3" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="AWS Profile" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="AwsProfileTextBox" Grid.Column="1" />
            </Grid>

            <CheckBox Grid.Row="4" x:Name="OpenReportAfterRunCheckBox" Content="実行後に HTML レポートを開く" Margin="0,0,0,6" />
            <CheckBox Grid.Row="5" x:Name="KeepConsoleOpenCheckBox" Content="子プロセスのコンソールを開いたままにする" Margin="0,0,0,6" />

            <TextBlock Grid.Row="6" x:Name="ConfigPathText" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Bottom" Margin="0,12,0,0" TextWrapping="Wrap" />

            <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="OpenConfigDirButton" Content="設定場所" Margin="0,0,8,0" />
                <Button x:Name="CancelButton" Content="キャンセル" Margin="0,0,8,0" />
                <Button x:Name="OkButton" Content="OK" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="aws-ec2-manager"
        Width="1100"
        Height="700">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8">
            <TextBlock Text="プロファイル:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="ProfileComboBox" Width="250" VerticalAlignment="Center" />
            <Button x:Name="OpenSsoButton" Content="開く" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="aws sso login --profile &lt;選択中&gt; を新しいコンソールで実行" />
            <TextBlock x:Name="ProfileInfoText" VerticalAlignment="Center" Margin="12,0,12,0" />
            <Button x:Name="CheckTokenButton" Content="トークン確認" Padding="8,2" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Tabs -->
        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="8,0,8,0">
            <TabItem Header="EC2 インスタンス">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="RefreshInstancesButton" Content="更新" Padding="10,4" Margin="0,0,8,0" />
                        <Button x:Name="StartInstanceButton" Content="起動" Padding="10,4" Margin="0,0,8,0" />
                        <Button x:Name="StopInstanceButton" Content="停止" Padding="10,4" Margin="0,0,8,0" />
                        <Button x:Name="RestartInstanceButton" Content="再起動" Padding="10,4" Margin="0,0,8,0" />
                    </StackPanel>
                    <DataGrid x:Name="InstancesGrid" Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" />
                            <DataGridTextColumn Header="InstanceId" Binding="{Binding InstanceId}" Width="160" />
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="90" />
                            <DataGridTextColumn Header="InstanceType" Binding="{Binding InstanceType}" Width="110" />
                            <DataGridTextColumn Header="AvailabilityZone" Binding="{Binding AvailabilityZone}" Width="120" />
                            <DataGridTextColumn Header="PrivateIpAddress" Binding="{Binding PrivateIpAddress}" Width="130" />
                            <DataGridTextColumn Header="PublicIpAddress" Binding="{Binding PublicIpAddress}" Width="130" />
                            <DataGridTextColumn Header="Platform" Binding="{Binding Platform}" Width="90" />
                            <DataGridTextColumn Header="VpcId" Binding="{Binding VpcId}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="セキュリティグループ">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="インスタンス:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="SgInstanceComboBox" Width="350" VerticalAlignment="Center"
                                  DisplayMemberPath="DisplayLabel" Margin="0,0,8,0" />
                        <Button x:Name="LoadSgButton" Content="読込" Padding="10,4" Margin="0,0,8,0" />
                        <Button x:Name="ApplySgButton" Content="適用" Padding="10,4" />
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock DockPanel.Dock="Top" Text="適用済み SG" FontWeight="Bold" Margin="0,0,0,4" />
                            <ListBox x:Name="AppliedSgList"
                                     DisplayMemberPath="DisplayLabel"
                                     SelectionMode="Extended" />
                        </DockPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,4,0">
                            <Button x:Name="MoveToAppliedButton" Content="&lt;" Width="40" Margin="0,0,0,8" Padding="0,4" />
                            <Button x:Name="MoveToAvailableButton" Content="&gt;" Width="40" Padding="0,4" />
                        </StackPanel>
                        <DockPanel Grid.Column="2" Margin="8,0,0,0">
                            <TextBlock DockPanel.Dock="Top" Text="未適用 SG（同 VPC）" FontWeight="Bold" Margin="0,0,0,4" />
                            <ListBox x:Name="AvailableSgList"
                                     DisplayMemberPath="DisplayLabel"
                                     SelectionMode="Extended" />
                        </DockPanel>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="ツール実行">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="インスタンス:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="SsmInstanceComboBox" Width="350" VerticalAlignment="Center"
                                  DisplayMemberPath="DisplayLabel" Margin="0,0,8,0" />
                        <Button x:Name="LoadSsmButton" Content="読込" Padding="10,4" Margin="0,0,8,0" />
                        <Button x:Name="RescanYamlButton" Content="再スキャン" Padding="10,4" />
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ListBox x:Name="YamlListBox" Grid.Column="0" Width="300"
                                 DisplayMemberPath="Name" Margin="0,0,8,0" />
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock x:Name="YamlInfoText" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="RunSsmButton" Content="実行" Padding="10,4" Margin="0,0,8,0" />
                                    <ProgressBar x:Name="SsmProgressBar" Width="200" Height="18"
                                                 IsIndeterminate="True" Visibility="Collapsed"
                                                 VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                            <TextBox x:Name="SsmOutputText" Grid.Row="1"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" />
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status bar -->
        <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Padding="8,4">
            <TextBlock x:Name="StatusBarText" Text="Ready" />
        </Border>
    </Grid>
</Window>

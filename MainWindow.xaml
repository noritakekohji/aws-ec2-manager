<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="aws-ec2-manager"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        Background="#0F172A"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBg" Color="#0F172A" />
        <SolidColorBrush x:Key="PanelBg" Color="#172033" />
        <SolidColorBrush x:Key="PanelAltBg" Color="#111827" />
        <SolidColorBrush x:Key="FieldBg" Color="#0B1220" />
        <SolidColorBrush x:Key="LineBrush" Color="#263247" />
        <SolidColorBrush x:Key="MutedText" Color="#94A3B8" />
        <SolidColorBrush x:Key="MainText" Color="#E5E7EB" />
        <SolidColorBrush x:Key="Accent" Color="#38BDF8" />
        <SolidColorBrush x:Key="AccentStrong" Color="#0EA5E9" />
        <SolidColorBrush x:Key="Success" Color="#22C55E" />
        <SolidColorBrush x:Key="Warn" Color="#F59E0B" />
        <SolidColorBrush x:Key="Danger" Color="#EF4444" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MainText}" />
        </Style>

        <Style x:Key="MutedLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EAF6FF" />
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#26364F" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#0B1220" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#64748B" />
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#111827" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#1F2937" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentStrong}" />
            <Setter Property="BorderBrush" Value="#7DD3FC" />
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#15803D" />
            <Setter Property="BorderBrush" Value="#4ADE80" />
        </Style>

        <Style x:Key="WarnButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#B45309" />
            <Setter Property="BorderBrush" Value="#FBBF24" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#B91C1C" />
            <Setter Property="BorderBrush" Value="#F87171" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource MainText}" />
            <Setter Property="Background" Value="{StaticResource FieldBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboChrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="28" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Content="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      ContentTemplate="{TemplateBinding ItemTemplate}"
                                                      RecognizesAccessKey="True" />
                                    <Path Grid.Column="1"
                                          Width="8"
                                          Height="5"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Fill="{StaticResource MutedText}"
                                          Data="M 0 0 L 8 0 L 4 5 Z" />
                                </Grid>
                            </Border>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          Opacity="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" />

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Slide">
                                <Grid MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="{StaticResource FieldBg}"
                                            BorderBrush="{StaticResource Accent}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="0,3,0,0" />
                                    <ScrollViewer Margin="1,4,1,1"
                                                  Background="{StaticResource FieldBg}">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="ToggleButton" Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="PART_Popup" Property="MinHeight" Value="30" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboChrome" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource MainText}" />
            <Setter Property="Background" Value="{StaticResource FieldBg}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemChrome"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              ContentSource="Content"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#1E293B" />
                                <Setter Property="Foreground" Value="#F8FAFC" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#075985" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#64748B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource MainText}" />
            <Setter Property="Background" Value="{StaticResource FieldBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Foreground" Value="{StaticResource MainText}" />
            <Setter Property="Background" Value="{StaticResource FieldBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Foreground" Value="{StaticResource MainText}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0EA5E9" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E293B" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource FieldBg}" />
            <Setter Property="Foreground" Value="{StaticResource MainText}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="RowBackground" Value="#0B1220" />
            <Setter Property="AlternatingRowBackground" Value="#111A2C" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#BAE6FD" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Foreground" Value="{StaticResource MainText}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E293B" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="#12344D" />
                    <Setter Property="Foreground" Value="#F8FAFC" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#075985" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Foreground" Value="{StaticResource MainText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="#12344D" />
                    <Setter Property="Foreground" Value="#F8FAFC" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#075985" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabChrome"
                                Background="#111827"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="6,6,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter TargetName="TabChrome" Property="Background" Value="{StaticResource PanelBg}" />
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E0F2FE" />
                                <Setter TargetName="TabChrome" Property="Background" Value="#1E293B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="18,14" BorderBrush="#263247" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#0B1220" Offset="0" />
                    <GradientStop Color="#142238" Offset="0.58" />
                    <GradientStop Color="#062235" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0">
                    <Border Width="36" Height="36" CornerRadius="8" Background="#0EA5E9" Margin="0,0,10,0">
                        <TextBlock Text="EC2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="White" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="aws-ec2-manager" FontSize="19" FontWeight="SemiBold" Foreground="#F8FAFC" />
                        <TextBlock Text="SSO / EC2 / Security Groups / SSM" Style="{StaticResource MutedLabel}" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="プロファイル" Style="{StaticResource MutedLabel}" Margin="0,0,8,0" />
                    <ComboBox x:Name="ProfileComboBox" Grid.Column="1" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,12,0">
                        <Button x:Name="OpenSsoButton" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="現在の AWS config を notepad で開く（無ければそのディレクトリをエクスプローラで開く）">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8E5;" Margin="0,0,7,0" />
                                <TextBlock Text="開く" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="LogButton" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="今日のログフォルダを開く">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" Margin="0,0,7,0" />
                                <TextBlock Text="ログ" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SettingsButton" VerticalAlignment="Center" ToolTip="AWS config / ログ出力先を変更">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Margin="0,0,7,0" />
                                <TextBlock Text="設定" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="ProfileInfoText" Grid.Column="3" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Button x:Name="SsoLoginButton" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="aws sso login --profile &lt;選択中&gt; を別ウィンドウで実行">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8D4;" Margin="0,0,7,0" />
                            <TextBlock Text="SSO ログイン" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CheckTokenButton" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" Margin="0,0,7,0" />
                            <TextBlock Text="トークン確認" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="16,14,16,12">
            <TabItem Header="EC2 インスタンス">
                <Border Style="{StaticResource PanelBorder}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button x:Name="RefreshInstancesButton" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" Margin="0,0,7,0" /><TextBlock Text="更新" /></StackPanel>
                                </Button>
                                <Button x:Name="StartInstanceButton" Style="{StaticResource SuccessButton}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" Margin="0,0,7,0" /><TextBlock Text="起動" /></StackPanel>
                                </Button>
                                <Button x:Name="StopInstanceButton" Style="{StaticResource WarnButton}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71A;" Margin="0,0,7,0" /><TextBlock Text="停止" /></StackPanel>
                                </Button>
                                <Button x:Name="RestartInstanceButton" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE777;" Margin="0,0,7,0" /><TextBlock Text="再起動" /></StackPanel>
                                </Button>
                                <Button x:Name="LockInstanceButton" Style="{StaticResource DangerButton}" Margin="0,0,8,0" ToolTip="選択中インスタンスへの操作を禁止">
                                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72E;" Margin="0,0,7,0" /><TextBlock Text="ロック" /></StackPanel>
                                </Button>
                                <Button x:Name="UnlockInstanceButton" ToolTip="選択中インスタンスの操作禁止を解除">
                                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE785;" Margin="0,0,7,0" /><TextBlock Text="ロック解除" /></StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Right" Text="EC2 Instances（ダブルクリックで詳細）" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </DockPanel>
                        <DataGrid x:Name="InstancesGrid" Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  RowHeaderWidth="0"
                                  AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="170" />
                                <DataGridTextColumn Header="ロック" Binding="{Binding LockState}" Width="70" />
                                <DataGridTextColumn Header="InstanceId" Binding="{Binding InstanceId}" Width="165" />
                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="90" />
                                <DataGridTextColumn Header="SSM" Binding="{Binding SsmStatus}" Width="90" />
                                <DataGridTextColumn Header="InstanceType" Binding="{Binding InstanceType}" Width="115" />
                                <DataGridTextColumn Header="AvailabilityZone" Binding="{Binding AvailabilityZone}" Width="130" />
                                <DataGridTextColumn Header="PrivateIpAddress" Binding="{Binding PrivateIpAddress}" Width="135" />
                                <DataGridTextColumn Header="PublicIpAddress" Binding="{Binding PublicIpAddress}" Width="135" />
                                <DataGridTextColumn Header="Platform" Binding="{Binding Platform}" Width="95" />
                                <DataGridTextColumn Header="SSM LastPing" Binding="{Binding SsmLastPingDateTime}" Width="155" />
                                <DataGridTextColumn Header="VpcId" Binding="{Binding VpcId}" Width="150" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="セキュリティグループ">
                <Border Style="{StaticResource PanelBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="380" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="インスタンス" Style="{StaticResource MutedLabel}" Margin="0,0,8,0" />
                            <ComboBox x:Name="SgInstanceComboBox" Grid.Column="1" VerticalAlignment="Center"
                                      Margin="0,0,8,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayLabel}" Foreground="{StaticResource MainText}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button x:Name="LoadSgButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" Margin="0,0,7,0" /><TextBlock Text="更新" /></StackPanel>
                            </Button>
                            <TextBlock Grid.Column="3" Text="Security Groups" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <Button x:Name="ExportSgReportButton" Grid.Column="4" Margin="0,0,8,0" ToolTip="現在の差分を一時HTMLでブラウザ表示">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9F9;" Margin="0,0,7,0" /><TextBlock Text="HTML出力" /></StackPanel>
                            </Button>
                            <Button x:Name="ApplySgButton" Grid.Column="5" Style="{StaticResource SuccessButton}">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" Margin="0,0,7,0" /><TextBlock Text="適用" /></StackPanel>
                            </Button>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*" />
                                <RowDefinition Height="3*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                                <TextBlock DockPanel.Dock="Top" Text="適用済み SG（ダブルクリックで詳細）" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#BAE6FD" />
                                <ListBox x:Name="AppliedSgList"
                                         DisplayMemberPath="DisplayLabel"
                                         SelectionMode="Extended" />
                            </DockPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="4,0,4,10">
                                <Button x:Name="MoveToAppliedButton" Content="&lt;" Width="44" Height="34" Margin="0,0,0,10" Padding="0" ToolTip="未適用 SG を適用済みに移動" />
                                <Button x:Name="MoveToAvailableButton" Content="&gt;" Width="44" Height="34" Padding="0" ToolTip="適用済み SG を未適用に移動" />
                            </StackPanel>
                            <DockPanel Grid.Row="0" Grid.Column="2" Margin="10,0,0,10">
                                <TextBlock DockPanel.Dock="Top" Text="未適用 SG（同 VPC / ダブルクリックで詳細）" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#BAE6FD" />
                                <ListBox x:Name="AvailableSgList"
                                         DisplayMemberPath="DisplayLabel"
                                         SelectionMode="Extended" />
                            </DockPanel>
                            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                    Background="{StaticResource PanelAltBg}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="10">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="インバウンド / アウトバウンド ルール差分" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#BAE6FD" />
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  Background="{StaticResource FieldBg}"
                                                  BorderBrush="{StaticResource LineBrush}"
                                                  BorderThickness="1">
                                        <StackPanel x:Name="SgDiffPanel" Margin="10" />
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="ツール実行">
                <Border Style="{StaticResource PanelBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="380" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="インスタンス" Style="{StaticResource MutedLabel}" Margin="0,0,8,0" />
                            <ComboBox x:Name="SsmInstanceComboBox" Grid.Column="1" VerticalAlignment="Center"
                                      Margin="0,0,8,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayLabel}" Foreground="{StaticResource MainText}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button x:Name="LoadSsmButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" Margin="0,0,7,0" /><TextBlock Text="更新" /></StackPanel>
                            </Button>
                            <Button x:Name="RescanYamlButton" Grid.Column="3" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" Margin="0,0,7,0" /><TextBlock Text="再スキャン" /></StackPanel>
                            </Button>
                            <Button x:Name="OpenYamlFolderButton" Grid.Column="4" ToolTip="YAML ファイル置き場を開く">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" Margin="0,0,7,0" /><TextBlock Text="フォルダ" /></StackPanel>
                            </Button>
                            <TextBlock Grid.Column="5" Text="SSM Run Command" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="310" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock DockPanel.Dock="Top" Text="タスク" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#BAE6FD" />
                                <Button x:Name="AddYamlButton" DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" Margin="0,0,7,0" /><TextBlock Text="新規追加" /></StackPanel>
                                </Button>
                                <ListBox x:Name="YamlListBox"
                                         DisplayMemberPath="Name" />
                            </DockPanel>
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{StaticResource PanelAltBg}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="420" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="YamlInfoText" Grid.Column="0" TextWrapping="Wrap" Foreground="{StaticResource MainText}" Margin="0,0,12,0" />
                                        <TextBox x:Name="YamlScriptPreviewText" Grid.Column="1"
                                                 Height="82"
                                                 Margin="0,0,12,0"
                                                 IsReadOnly="False"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 TextWrapping="NoWrap"
                                                 FontFamily="Consolas"
                                                 FontSize="12"
                                                 Foreground="{StaticResource MainText}"
                                                 Background="#0B1220"
                                                 BorderBrush="{StaticResource LineBrush}" />
                                        <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center">
                                            <Button x:Name="SaveYamlButton" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" Margin="0,0,7,0" /><TextBlock Text="保存" /></StackPanel>
                                            </Button>
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="RunSsmButton" Style="{StaticResource SuccessButton}" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" Margin="0,0,7,0" /><TextBlock Text="実行" /></StackPanel>
                                                </Button>
                                                <ProgressBar x:Name="SsmProgressBar" Width="180" Height="14"
                                                             IsIndeterminate="True" Visibility="Collapsed"
                                                             VerticalAlignment="Center"
                                                             Foreground="{StaticResource AccentStrong}"
                                                             Background="#0B1220" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBox x:Name="SsmOutputText" Grid.Row="1"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Consolas"
                                         FontSize="12" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#0B1220" BorderBrush="#263247" BorderThickness="0,1,0,0" Padding="14,7">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="8" Height="8" CornerRadius="4" Background="{StaticResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusBarText" Text="Ready" Foreground="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>

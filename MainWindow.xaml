<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="aws-ec2-manager"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        Background="#0F172A"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBg" Color="#0F172A" />
        <SolidColorBrush x:Key="PanelBg" Color="#172033" />
        <SolidColorBrush x:Key="PanelAltBg" Color="#111827" />
        <SolidColorBrush x:Key="FieldBg" Color="#0B1220" />
        <SolidColorBrush x:Key="LineBrush" Color="#263247" />
        <SolidColorBrush x:Key="MutedText" Color="#94A3B8" />
        <SolidColorBrush x:Key="MainText" Color="#E5E7EB" />
        <SolidColorBrush x:Key="Accent" Color="#38BDF8" />
        <SolidColorBrush x:Key="AccentStrong" Color="#0EA5E9" />
        <SolidColorBrush x:Key="Success" Color="#22C55E" />
        <SolidColorBrush x:Key="Warn" Color="#F59E0B" />
        <SolidColorBrush x:Key="Danger" Color="#EF4444" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MainText}" />
        </Style>

        <Style x:Key="MutedLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EAF6FF" />
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#26364F" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#0B1220" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#64748B" />
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#111827" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#1F2937" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentStrong}" />
            <Setter Property="BorderBrush" Value="#7DD3FC" />
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#15803D" />
            <Setter Property="BorderBrush" Value="#4ADE80" />
        </Style>

        <Style x:Key="WarnButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#B45309" />
            <Setter Property="BorderBrush" Value="#FBBF24" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#B91C1C" />
            <Setter Property="BorderBrush" Value="#F87171" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource MainText}" />
            <Setter Property="Background" Value="{StaticResource FieldBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboChrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="28" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Content="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      ContentTemplate="{TemplateBinding ItemTemplate}"
                                                      RecognizesAccessKey="True" />
                                    <Path Grid.Column="1"
                                          Width="8"
                                          Height="5"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Fill="{StaticResource MutedText}"
                                          Data="M 0 0 L 8 0 L 4 5 Z" />
                                </Grid>
                            </Border>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          Opacity="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" />

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Slide">
                                <Grid MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="{StaticResource FieldBg}"
                                            BorderBrush="{StaticResource Accent}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="0,3,0,0" />
                                    <ScrollViewer Margin="1,4,1,1"
                                                  Background="{StaticResource FieldBg}">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="ToggleButton" Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="PART_Popup" Property="MinHeight" Value="30" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboChrome" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource MainText}" />
            <Setter Property="Background" Value="{StaticResource FieldBg}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemChrome"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              ContentSource="Content"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#1E293B" />
                                <Setter Property="Foreground" Value="#F8FAFC" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#075985" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#64748B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource MainText}" />
            <Setter Property="Background" Value="{StaticResource FieldBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Foreground" Value="{StaticResource MainText}" />
            <Setter Property="Background" Value="{StaticResource FieldBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Foreground" Value="{StaticResource MainText}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0EA5E9" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E293B" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource FieldBg}" />
            <Setter Property="Foreground" Value="{StaticResource MainText}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="RowBackground" Value="#0B1220" />
            <Setter Property="AlternatingRowBackground" Value="#111A2C" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#BAE6FD" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Foreground" Value="{StaticResource MainText}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E293B" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="#12344D" />
                    <Setter Property="Foreground" Value="#F8FAFC" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#075985" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Foreground" Value="{StaticResource MainText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="#12344D" />
                    <Setter Property="Foreground" Value="#F8FAFC" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#075985" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabChrome"
                                Background="#111827"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="6,6,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter TargetName="TabChrome" Property="Background" Value="{StaticResource PanelBg}" />
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E0F2FE" />
                                <Setter TargetName="TabChrome" Property="Background" Value="#1E293B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="18,14" BorderBrush="#263247" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#0B1220" Offset="0" />
                    <GradientStop Color="#142238" Offset="0.58" />
                    <GradientStop Color="#062235" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0">
                    <Border Width="36" Height="36" CornerRadius="8" Background="#0EA5E9" Margin="0,0,10,0">
                        <TextBlock Text="EC2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="White" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="aws-ec2-manager" FontSize="19" FontWeight="SemiBold" Foreground="#F8FAFC" />
                        <TextBlock Text="SSO / EC2 / Security Groups / SSM" Style="{StaticResource MutedLabel}" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="プロファイル" Style="{StaticResource MutedLabel}" Margin="0,0,8,0" />
                    <ComboBox x:Name="ProfileComboBox" Grid.Column="1" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,12,0">
                        <Button x:Name="OpenSsoButton" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="現在の AWS config を notepad で開く（無ければそのディレクトリをエクスプローラで開く）">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8E5;" Margin="0,0,7,0" />
                                <TextBlock Text="開く" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="LogButton" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="今日のログフォルダを開く">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" Margin="0,0,7,0" />
                                <TextBlock Text="ログ" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SettingsButton" VerticalAlignment="Center" ToolTip="AWS config / ログ出力先を変更">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Margin="0,0,7,0" />
                                <TextBlock Text="設定" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="ProfileInfoText" Grid.Column="3" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Button x:Name="SsoLoginButton" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="aws sso login --profile &lt;選択中&gt; を別ウィンドウで実行">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8D4;" Margin="0,0,7,0" />
                            <TextBlock Text="SSO ログイン" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CheckTokenButton" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" Margin="0,0,7,0" />
                            <TextBlock Text="トークン確認" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16,14,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390" MinWidth="290" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="460" />
            </Grid.ColumnDefinitions>

            <!-- ============ 左ペイン: インスタンス一覧(マスター) ============ -->
            <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <Button x:Name="RefreshInstancesButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" ToolTip="AWS からインスタンス一覧を再取得">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" Margin="0,0,7,0" /><TextBlock Text="更新" /></StackPanel>
                        </Button>
                        <Grid>
                            <TextBox x:Name="InstanceFilterBox" VerticalContentAlignment="Center" ToolTip="Name / InstanceId / IP の部分一致で絞り込み" />
                            <TextBlock x:Name="InstanceFilterHint"
                                       Foreground="{StaticResource MutedText}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <Run FontFamily="Segoe MDL2 Assets" Text="&#xE721;" /><Run Text=" Name / ID / IP で絞り込み" />
                            </TextBlock>
                        </Grid>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <DataGrid x:Name="InstancesGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  RowHeaderWidth="0"
                                  AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="100" />
                                <DataGridTextColumn Header="&#128274;" Binding="{Binding LockState}" Width="52" />
                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="78" />
                                <DataGridTextColumn Header="SSM" Binding="{Binding SsmStatus}" Width="68" />
                                <DataGridTextColumn Header="InstanceId" Binding="{Binding InstanceId}" Width="150" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="InstanceEmptyText"
                                   Text="インスタンスがありません。プロファイルを選択して「更新」を押してください。"
                                   Foreground="{StaticResource MutedText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   MaxWidth="280"
                                   Visibility="Collapsed" />
                        <ProgressBar x:Name="InstanceListProgressBar"
                                     Height="4"
                                     VerticalAlignment="Top"
                                     IsIndeterminate="True"
                                     Visibility="Collapsed"
                                     Foreground="{StaticResource AccentStrong}"
                                     Background="Transparent"
                                     BorderThickness="0" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock x:Name="InstanceCountText" DockPanel.Dock="Right" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Text="" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="StartInstanceButton" Style="{StaticResource SuccessButton}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" Margin="0,0,7,0" /><TextBlock Text="起動" /></StackPanel>
                                </Button>
                                <Button x:Name="StopInstanceButton" Style="{StaticResource WarnButton}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71A;" Margin="0,0,7,0" /><TextBlock Text="停止" /></StackPanel>
                                </Button>
                                <Button x:Name="RestartInstanceButton">
                                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE777;" Margin="0,0,7,0" /><TextBlock Text="再起動" /></StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <Button x:Name="LockInstanceButton" Style="{StaticResource DangerButton}" Margin="0,0,8,0" ToolTip="選択中インスタンスへの操作を禁止">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72E;" Margin="0,0,7,0" /><TextBlock Text="ロック" /></StackPanel>
                            </Button>
                            <Button x:Name="UnlockInstanceButton" ToolTip="選択中インスタンスの操作禁止を解除">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE785;" Margin="0,0,7,0" /><TextBlock Text="ロック解除" /></StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ShowsPreview="False" />

            <!-- ============ 右ペイン: 選択インスタンスへの操作(ディテール) ============ -->
            <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="2,0,2,10">
                        <TextBlock x:Name="SelectedInstanceSubText"
                                   DockPanel.Dock="Right"
                                   Foreground="{StaticResource MutedText}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Text="" />
                        <TextBlock x:Name="SelectedInstanceHeaderText"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#F8FAFC"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Text="インスタンス未選択" />
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <TabControl x:Name="DetailTabs">
                            <TabItem Header="詳細">
                                <DataGrid x:Name="DetailGrid"
                                          Margin="0,10,0,0"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="None"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          RowHeaderWidth="0"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="{StaticResource LineBrush}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding Name}" Width="220">
                                            <DataGridTextColumn.CellStyle>
                                                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedText}" />
                                                </Style>
                                            </DataGridTextColumn.CellStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding Value}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>

                            <TabItem Header="セキュリティグループ">
                                <Grid Margin="0,10,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button x:Name="ExportSgReportButton" Margin="0,0,8,0" ToolTip="現在の差分をHTML出力してブラウザで開く">
                                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9F9;" Margin="0,0,7,0" /><TextBlock Text="HTML出力" /></StackPanel>
                                            </Button>
                                            <Button x:Name="ApplySgButton" Style="{StaticResource SuccessButton}">
                                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" Margin="0,0,7,0" /><TextBlock Text="適用" /></StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="ReloadSgButton" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" ToolTip="この インスタンスの SG 情報を再取得">
                                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" Margin="0,0,7,0" /><TextBlock Text="再取得" /></StackPanel>
                                            </Button>
                                            <TextBlock x:Name="SgStatusText" Text="Security Groups" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DockPanel>
                                    <Grid Grid.Row="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="2*" />
                                            <RowDefinition Height="3*" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                                            <TextBlock DockPanel.Dock="Top" Text="適用済み SG（ダブルクリックで詳細）" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#BAE6FD" />
                                            <ListBox x:Name="AppliedSgList"
                                                     DisplayMemberPath="DisplayLabel"
                                                     SelectionMode="Extended" />
                                        </DockPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="4,0,4,10">
                                            <Button x:Name="MoveToAppliedButton" Content="&lt;" Width="44" Height="34" Margin="0,0,0,10" Padding="0" ToolTip="未適用 SG を適用済みに移動" />
                                            <Button x:Name="MoveToAvailableButton" Content="&gt;" Width="44" Height="34" Padding="0" ToolTip="適用済み SG を未適用に移動" />
                                        </StackPanel>
                                        <DockPanel Grid.Row="0" Grid.Column="2" Margin="10,0,0,10">
                                            <TextBlock DockPanel.Dock="Top" Text="未適用 SG（同 VPC / ダブルクリックで詳細）" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#BAE6FD" />
                                            <ListBox x:Name="AvailableSgList"
                                                     DisplayMemberPath="DisplayLabel"
                                                     SelectionMode="Extended" />
                                        </DockPanel>
                                        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                                Background="{StaticResource PanelAltBg}"
                                                BorderBrush="{StaticResource LineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="7"
                                                Padding="10">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Top" Text="インバウンド / アウトバウンド ルール差分" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#BAE6FD" />
                                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                              Background="{StaticResource FieldBg}"
                                                              BorderBrush="{StaticResource LineBrush}"
                                                              BorderThickness="1">
                                                    <StackPanel x:Name="SgDiffPanel" Margin="10" />
                                                </ScrollViewer>
                                            </DockPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </TabItem>

                            <TabItem Header="インスタンスロール">
                                <Grid Margin="0,10,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                        <Button x:Name="ApplyRoleButton" DockPanel.Dock="Right" Style="{StaticResource SuccessButton}">
                                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" Margin="0,0,7,0" /><TextBlock Text="適用" /></StackPanel>
                                        </Button>
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="ReloadRoleButton" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" ToolTip="このインスタンスのロール情報を再取得">
                                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" Margin="0,0,7,0" /><TextBlock Text="再取得" /></StackPanel>
                                            </Button>
                                            <TextBlock x:Name="RoleStatusText" Text="IAM Instance Profile" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DockPanel>
                                    <Grid Grid.Row="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="2*" />
                                            <RowDefinition Height="3*" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                                            <TextBlock DockPanel.Dock="Top" Text="適用予定 Instance Profile" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#BAE6FD" />
                                            <ListBox x:Name="AppliedRoleList"
                                                     DisplayMemberPath="DisplayLabel"
                                                     SelectionMode="Single" />
                                        </DockPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="4,0,4,10">
                                            <Button x:Name="MoveRoleToAppliedButton" Content="&lt;" Width="44" Height="34" Margin="0,0,0,10" Padding="0" ToolTip="候補 Instance Profile を適用予定に移動" />
                                            <Button x:Name="MoveRoleToAvailableButton" Content="&gt;" Width="44" Height="34" Padding="0" ToolTip="適用予定 Instance Profile を外す" />
                                        </StackPanel>
                                        <DockPanel Grid.Row="0" Grid.Column="2" Margin="10,0,0,10">
                                            <TextBlock DockPanel.Dock="Top" Text="候補 Instance Profile（含まれる Role を表示）" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#BAE6FD" />
                                            <ListBox x:Name="AvailableRoleList"
                                                     DisplayMemberPath="DisplayLabel"
                                                     SelectionMode="Single" />
                                        </DockPanel>
                                        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                                Background="{StaticResource PanelAltBg}"
                                                BorderBrush="{StaticResource LineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="7"
                                                Padding="10">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Top" Text="操作差分" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#BAE6FD" />
                                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                              Background="{StaticResource FieldBg}"
                                                              BorderBrush="{StaticResource LineBrush}"
                                                              BorderThickness="1">
                                                    <StackPanel x:Name="RoleDiffPanel" Margin="10" />
                                                </ScrollViewer>
                                            </DockPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </TabItem>

                            <TabItem Header="ツール実行">
                                <Grid Margin="0,10,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                        <TextBlock x:Name="SsmPlatformText" DockPanel.Dock="Right" Text="SSM Run Command" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="RescanYamlButton" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" Margin="0,0,7,0" /><TextBlock Text="再スキャン" /></StackPanel>
                                            </Button>
                                            <Button x:Name="OpenYamlFolderButton" ToolTip="YAML ファイル置き場を開く">
                                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" Margin="0,0,7,0" /><TextBlock Text="フォルダ" /></StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </DockPanel>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="290" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <DockPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock DockPanel.Dock="Top" Text="タスク（ダブルクリックで改名）" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#BAE6FD" />
                                            <Button x:Name="AddYamlButton" DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" Margin="0,0,7,0" /><TextBlock Text="新規追加" /></StackPanel>
                                            </Button>
                                            <ListBox x:Name="YamlListBox"
                                                     DisplayMemberPath="Name" />
                                        </DockPanel>
                                        <Grid Grid.Column="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Background="{StaticResource PanelAltBg}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="YamlInfoText" Grid.Column="0" TextWrapping="Wrap" Foreground="{StaticResource MainText}" Margin="0,0,12,0" />
                                                    <TextBox x:Name="YamlScriptPreviewText" Grid.Column="1"
                                                             Height="82"
                                                             Margin="0,0,12,0"
                                                             IsReadOnly="False"
                                                             AcceptsReturn="True"
                                                             VerticalScrollBarVisibility="Auto"
                                                             HorizontalScrollBarVisibility="Auto"
                                                             TextWrapping="NoWrap"
                                                             FontFamily="Consolas"
                                                             FontSize="12"
                                                             Foreground="{StaticResource MainText}"
                                                             Background="#0B1220"
                                                             BorderBrush="{StaticResource LineBrush}" />
                                                    <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center">
                                                        <Button x:Name="SaveYamlButton" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8">
                                                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" Margin="0,0,7,0" /><TextBlock Text="保存" /></StackPanel>
                                                        </Button>
                                                        <Button x:Name="RunSsmButton" Style="{StaticResource SuccessButton}">
                                                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" Margin="0,0,7,0" /><TextBlock Text="実行" /></StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <TextBox x:Name="SsmOutputText" Grid.Row="1"
                                                     IsReadOnly="True"
                                                     AcceptsReturn="True"
                                                     VerticalScrollBarVisibility="Auto"
                                                     HorizontalScrollBarVisibility="Auto"
                                                     FontFamily="Consolas"
                                                     FontSize="12" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </TabItem>
                        </TabControl>

                        <Border x:Name="NoSelectionOverlay"
                                Background="{StaticResource PanelBg}"
                                Visibility="Visible">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                <TextBlock Text="左の一覧からインスタンスを選択してください" Foreground="{StaticResource MutedText}" FontSize="14" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#0B1220" BorderBrush="#263247" BorderThickness="0,1,0,0" Padding="14,7">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="8" Height="8" CornerRadius="4" Background="{StaticResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <Button x:Name="CancelTaskButton"
                        DockPanel.Dock="Right"
                        Style="{StaticResource DangerButton}"
                        Padding="10,2"
                        MinHeight="22"
                        Visibility="Collapsed"
                        ToolTip="実行中の AWS 操作を中断する">
                    <TextBlock Text="キャンセル" FontSize="11" />
                </Button>
                <ProgressBar x:Name="TaskProgressBar"
                             DockPanel.Dock="Right"
                             Width="150" Height="12"
                             Margin="0,0,10,0"
                             IsIndeterminate="True"
                             Visibility="Collapsed"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource AccentStrong}"
                             Background="#172033" />
                <TextBlock x:Name="StatusBarText" Text="Ready" Foreground="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
